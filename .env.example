# Copy this file to .env and fill in your keys before running.

# ── LLM Providers ──────────────────────────────────────────────────────────────
# Groq is used as the primary LLM (free tier). Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Claude is the fallback if Groq hits a rate limit. Requires an Anthropic API key.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3200
